{
  "name": "pi-larkd",
  "version": "0.1.0",
  "description": "Feishu (Lark) duplex super-agent daemon on pi-durable",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm test && pnpm lint"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@chat-adapter/state-memory": "4.44.0",
    "@earendil-works/chord": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@larksuite/vercel-chat-adapter": "0.3.0",
    "chat": "4.44.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "esbuild",
      "protobufjs"
    ]
  }
}
